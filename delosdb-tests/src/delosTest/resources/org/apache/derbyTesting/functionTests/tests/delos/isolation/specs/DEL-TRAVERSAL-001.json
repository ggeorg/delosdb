{
  "id": "DEL-TRAVERSAL-001",
  "description": "A delete waits behind a concurrent update and then removes the committed row exactly once.",
  "category": "update-delete-traversal",
  "providers": [
    "heap",
    "mvcc"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table traversal_same_t (id int primary key, payload varchar(32))${providerClause}",
    "insert into traversal_same_t values (1,'base')"
  ],
  "sessions": {
    "updater": {
      "steps": {
        "update": {
          "sql": "update traversal_same_t set payload='updated' where id=1",
          "updateCount": 1
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    },
    "deleter": {
      "steps": {
        "delete": {
          "sql": "delete from traversal_same_t where id=1",
          "updateCount": 1
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    }
  },
  "permutations": [
    {
      "name": "update-then-delete",
      "operations": [
        {
          "type": "RUN",
          "step": "updater.update"
        },
        {
          "type": "START",
          "step": "deleter.delete",
          "token": "deleteRow"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "deleteRow",
          "timeoutMillis": 1200
        },
        {
          "type": "RUN",
          "step": "updater.commit"
        },
        {
          "type": "AWAIT",
          "token": "deleteRow",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "deleter.commit"
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "sql": "select count(*) from traversal_same_t",
      "rows": [
        "0"
      ]
    }
  ],
  "teardown": [
    "drop table traversal_same_t"
  ]
}
