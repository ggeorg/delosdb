{
  "id": "DEL-MERGE-001",
  "description": "A conflicting MERGE waits behind the target writer; heap applies the source value, while MVCC must end in one of the two serial outcomes: source applied or deterministic SQLState 40001.",
  "category": "merge-concurrency",
  "providers": [
    "heap",
    "mvcc"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table merge_target_t (id int primary key,payload int)${providerClause}",
    "create table merge_source_t (id int primary key,payload int)${providerClause}",
    "insert into merge_target_t values (1,0),(2,0)",
    "insert into merge_source_t values (1,20),(2,30)"
  ],
  "sessions": {
    "writer": {
      "steps": {
        "update": {
          "sql": "update merge_target_t set payload=10 where id=1",
          "updateCount": 1
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    },
    "merger": {
      "steps": {
        "merge": {
          "sql": "merge into merge_target_t using merge_source_t on merge_target_t.id=merge_source_t.id when matched and merge_target_t.id=1 then update set payload=merge_source_t.payload",
          "updateCount": 1,
          "sqlStates": [
            "40001"
          ],
          "successAllowed": true
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    }
  },
  "permutations": [
    {
      "name": "merge-conflicting-update-heap",
      "providers": [
        "heap"
      ],
      "operations": [
        {
          "type": "RUN",
          "step": "writer.update"
        },
        {
          "type": "START",
          "step": "merger.merge",
          "token": "mergeUpdate"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "mergeUpdate",
          "timeoutMillis": 1200
        },
        {
          "type": "RUN",
          "step": "writer.commit"
        },
        {
          "type": "AWAIT",
          "token": "mergeUpdate",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "merger.commit"
        }
      ],
      "sqlStateAssertions": [
        {
          "sqlState": "40001",
          "minimum": 0,
          "maximum": 0
        }
      ]
    },
    {
      "name": "merge-conflicting-update-mvcc",
      "providers": [
        "mvcc"
      ],
      "operations": [
        {
          "type": "RUN",
          "step": "writer.update"
        },
        {
          "type": "START",
          "step": "merger.merge",
          "token": "mergeUpdate"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "mergeUpdate",
          "timeoutMillis": 1200
        },
        {
          "type": "RUN",
          "step": "writer.commit"
        },
        {
          "type": "AWAIT",
          "token": "mergeUpdate",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "merger.commit"
        }
      ],
      "sqlStateAssertions": [
        {
          "sqlState": "40001",
          "minimum": 0,
          "maximum": 1
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "providers": [
        "heap"
      ],
      "sql": "select id,payload from merge_target_t order by id",
      "rows": [
        "1|20",
        "2|0"
      ]
    },
    {
      "providers": [
        "mvcc"
      ],
      "sql": "select case when count(*)=2 and max(case when id=1 and payload in (10,20) then 1 else 0 end)=1 and max(case when id=2 and payload=0 then 1 else 0 end)=1 then 1 else 0 end from merge_target_t",
      "rows": [
        "1"
      ]
    }
  ],
  "teardown": [
    "drop table merge_source_t",
    "drop table merge_target_t"
  ]
}
