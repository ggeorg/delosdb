{
  "id": "DEL-ISO-013",
  "description": "Rollback to a savepoint must not lose the pre-savepoint row lock: a conflicting FOR UPDATE remains blocked until the outer transaction commits; the exact retained lock strength is provider-specific.",
  "category": "savepoint-rollback",
  "providers": [
    "heap"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table savepoint_lock_t (id int primary key, payload varchar(32))${providerClause}",
    "insert into savepoint_lock_t values (1, 'one')"
  ],
  "sessions": {
    "holder": {
      "isolation": "REPEATABLE_READ",
      "steps": {
        "read": {
          "sql": "select id,payload from savepoint_lock_t where id=1",
          "rows": [
            "1|one"
          ]
        },
        "savepoint": {
          "action": "SAVEPOINT",
          "savepoint": "before_delete"
        },
        "delete": {
          "sql": "delete from savepoint_lock_t where id=1",
          "updateCount": 1
        },
        "rollback": {
          "action": "ROLLBACK_TO_SAVEPOINT",
          "savepoint": "before_delete"
        },
        "restored": {
          "sql": "select id,payload from savepoint_lock_t where id=1",
          "rows": [
            "1|one"
          ]
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    },
    "writer": {
      "steps": {
        "lock": {
          "sql": "select id,payload from savepoint_lock_t where id=1 for update",
          "rows": [
            "1|one"
          ]
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    }
  },
  "permutations": [
    {
      "name": "restore-pre-savepoint-lock",
      "operations": [
        {
          "type": "RUN",
          "step": "holder.read"
        },
        {
          "type": "RUN",
          "step": "holder.savepoint"
        },
        {
          "type": "RUN",
          "step": "holder.delete"
        },
        {
          "type": "RUN",
          "step": "holder.rollback"
        },
        {
          "type": "RUN",
          "step": "holder.restored"
        },
        {
          "type": "START",
          "step": "writer.lock",
          "token": "writerLock"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "writerLock",
          "timeoutMillis": 1200
        },
        {
          "type": "RUN",
          "step": "holder.commit"
        },
        {
          "type": "AWAIT",
          "token": "writerLock",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "writer.commit"
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "sql": "select id,payload from savepoint_lock_t",
      "rows": [
        "1|one"
      ]
    }
  ],
  "teardown": [
    "drop table savepoint_lock_t"
  ]
}
