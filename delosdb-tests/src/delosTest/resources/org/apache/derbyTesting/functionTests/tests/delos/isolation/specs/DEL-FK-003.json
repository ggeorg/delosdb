{
  "id": "DEL-FK-003",
  "description": "Crossed parent deletes and child inserts form one foreign-key deadlock victim with consistent survivors.",
  "category": "foreign-key-concurrency",
  "providers": [
    "heap",
    "mvcc"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table fk_parent_t (id int primary key)${providerClause}",
    "create table fk_child_t (id int primary key,parent_id int,constraint fk_child_parent foreign key(parent_id) references fk_parent_t(id))${providerClause}",
    "insert into fk_parent_t values (1),(2)"
  ],
  "sessions": {
    "one": {
      "steps": {
        "delete": {
          "sql": "delete from fk_parent_t where id=1",
          "updateCount": 1
        },
        "insert": {
          "sql": "insert into fk_child_t values (101,2)",
          "updateCount": 1,
          "sqlStates": [
            "40001"
          ],
          "successAllowed": true
        }
      }
    },
    "two": {
      "steps": {
        "delete": {
          "sql": "delete from fk_parent_t where id=2",
          "updateCount": 1
        },
        "insert": {
          "sql": "insert into fk_child_t values (102,1)",
          "updateCount": 1,
          "sqlStates": [
            "40001"
          ],
          "successAllowed": true
        }
      }
    }
  },
  "permutations": [
    {
      "name": "foreign-key-cycle",
      "operations": [
        {
          "type": "RUN",
          "step": "one.delete"
        },
        {
          "type": "RUN",
          "step": "two.delete"
        },
        {
          "type": "START",
          "step": "one.insert",
          "token": "oneInsert"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "oneInsert",
          "timeoutMillis": 1200
        },
        {
          "type": "START",
          "step": "two.insert",
          "token": "twoInsert"
        },
        {
          "type": "DRAIN_AND_COMMIT",
          "timeoutMillis": 12000
        }
      ],
      "sqlStateAssertions": [
        {
          "sqlState": "40001",
          "minimum": 1,
          "maximum": 1
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "sql": "select count(*) from fk_parent_t",
      "rows": [
        "1"
      ]
    },
    {
      "sql": "select count(*) from fk_child_t",
      "rows": [
        "1"
      ]
    }
  ],
  "teardown": [
    "drop table fk_child_t",
    "drop table fk_parent_t"
  ]
}
