{
  "id": "DEL-FK-002",
  "description": "A child insert started against an uncommitted parent delete is rejected with 23503; after the delete rolls back and the child transaction is reset, an explicit retry commits successfully.",
  "category": "foreign-key-concurrency",
  "providers": [
    "heap",
    "mvcc"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table fk_parent_t (id int primary key)${providerClause}",
    "create table fk_child_t (id int primary key,parent_id int,constraint fk_child_parent foreign key(parent_id) references fk_parent_t(id))${providerClause}",
    "insert into fk_parent_t values (1),(2)"
  ],
  "sessions": {
    "parent": {
      "steps": {
        "delete": {
          "sql": "delete from fk_parent_t where id=1",
          "updateCount": 1
        },
        "rollback": {
          "action": "ROLLBACK"
        }
      }
    },
    "child": {
      "steps": {
        "attempt": {
          "sql": "insert into fk_child_t values (10,1)",
          "updateCount": 1,
          "sqlStates": [
            "23503"
          ],
          "successAllowed": false
        },
        "rollback": {
          "action": "ROLLBACK"
        },
        "retry": {
          "sql": "insert into fk_child_t values (10,1)",
          "updateCount": 1
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    }
  },
  "permutations": [
    {
      "name": "rollback-and-explicit-retry-heap",
      "providers": [
        "heap"
      ],
      "operations": [
        {
          "type": "RUN",
          "step": "parent.delete"
        },
        {
          "type": "START",
          "step": "child.attempt",
          "token": "childAttempt"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "childAttempt",
          "timeoutMillis": 1200
        },
        {
          "type": "RUN",
          "step": "parent.rollback"
        },
        {
          "type": "AWAIT",
          "token": "childAttempt",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "child.rollback"
        },
        {
          "type": "RUN",
          "step": "child.retry"
        },
        {
          "type": "RUN",
          "step": "child.commit"
        }
      ],
      "sqlStateAssertions": [
        {
          "sqlState": "23503",
          "minimum": 1,
          "maximum": 1
        }
      ]
    },
    {
      "name": "rollback-and-explicit-retry-mvcc",
      "providers": [
        "mvcc"
      ],
      "operations": [
        {
          "type": "RUN",
          "step": "parent.delete"
        },
        {
          "type": "RUN",
          "step": "child.attempt"
        },
        {
          "type": "RUN",
          "step": "parent.rollback"
        },
        {
          "type": "RUN",
          "step": "child.rollback"
        },
        {
          "type": "RUN",
          "step": "child.retry"
        },
        {
          "type": "RUN",
          "step": "child.commit"
        }
      ],
      "sqlStateAssertions": [
        {
          "sqlState": "23503",
          "minimum": 1,
          "maximum": 1
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "sql": "select count(*) from fk_parent_t",
      "rows": [
        "2"
      ]
    },
    {
      "sql": "select id,parent_id from fk_child_t",
      "rows": [
        "10|1"
      ]
    }
  ],
  "teardown": [
    "drop table fk_child_t",
    "drop table fk_parent_t"
  ]
}
