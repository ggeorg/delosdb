{
  "id": "DEL-DDL-002",
  "description": "CREATE INDEX waits for active DML and publishes a usable index after the writer commits.",
  "category": "ddl-concurrency",
  "providers": [
    "heap",
    "mvcc"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table ddl_index_t (id int primary key,bucket int)${providerClause}",
    "insert into ddl_index_t values (1,10),(2,20)"
  ],
  "sessions": {
    "writer": {
      "steps": {
        "update": {
          "sql": "update ddl_index_t set bucket=11 where id=1",
          "updateCount": 1
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    },
    "ddl": {
      "steps": {
        "create": {
          "sql": "create index ddl_create_idx on ddl_index_t(bucket)"
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    }
  },
  "permutations": [
    {
      "name": "index-create-versus-dml",
      "operations": [
        {
          "type": "RUN",
          "step": "writer.update"
        },
        {
          "type": "START",
          "step": "ddl.create",
          "token": "createIndex"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "createIndex",
          "timeoutMillis": 1200
        },
        {
          "type": "RUN",
          "step": "writer.commit"
        },
        {
          "type": "AWAIT",
          "token": "createIndex",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "ddl.commit"
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "sql": "select count(*) from sys.sysconglomerates where conglomeratename='DDL_CREATE_IDX'",
      "rows": [
        "1"
      ]
    },
    {
      "sql": "select id from ddl_index_t where bucket=11",
      "rows": [
        "1"
      ]
    }
  ],
  "teardown": [
    "drop table ddl_index_t"
  ]
}
