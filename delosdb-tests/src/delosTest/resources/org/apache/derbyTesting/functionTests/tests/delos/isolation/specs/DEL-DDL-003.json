{
  "id": "DEL-DDL-003",
  "description": "TRUNCATE waits for a heap repeatable-read transaction. Because TRUNCATE TABLE is not supported for delos_mvcc tables, the MVCC schedule must reject it with SQLState 0A000 without changing the table.",
  "category": "ddl-concurrency",
  "providers": [
    "heap",
    "mvcc"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table ddl_truncate_t (id int primary key)${providerClause}",
    "insert into ddl_truncate_t values (1),(2),(3)"
  ],
  "sessions": {
    "reader": {
      "isolation": "REPEATABLE_READ",
      "steps": {
        "read": {
          "sql": "select count(*) from ddl_truncate_t",
          "rows": [
            "3"
          ]
        },
        "stable": {
          "sql": "select count(*) from ddl_truncate_t",
          "rows": [
            "3"
          ]
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    },
    "ddl": {
      "steps": {
        "truncateHeap": {
          "sql": "truncate table ddl_truncate_t"
        },
        "truncateMvccUnsupported": {
          "sql": "truncate table ddl_truncate_t",
          "sqlStates": [
            "0A000"
          ],
          "successAllowed": false
        },
        "commit": {
          "action": "COMMIT"
        },
        "rollback": {
          "action": "ROLLBACK"
        }
      }
    }
  },
  "permutations": [
    {
      "name": "truncate-versus-reader-heap",
      "providers": [
        "heap"
      ],
      "operations": [
        {
          "type": "RUN",
          "step": "reader.read"
        },
        {
          "type": "START",
          "step": "ddl.truncateHeap",
          "token": "truncateTable"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "truncateTable",
          "timeoutMillis": 1200
        },
        {
          "type": "RUN",
          "step": "reader.stable"
        },
        {
          "type": "RUN",
          "step": "reader.commit"
        },
        {
          "type": "AWAIT",
          "token": "truncateTable",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "ddl.commit"
        }
      ]
    },
    {
      "name": "truncate-unsupported-mvcc",
      "providers": [
        "mvcc"
      ],
      "operations": [
        {
          "type": "RUN",
          "step": "reader.read"
        },
        {
          "type": "RUN",
          "step": "ddl.truncateMvccUnsupported"
        },
        {
          "type": "RUN",
          "step": "reader.stable"
        },
        {
          "type": "RUN",
          "step": "ddl.rollback"
        },
        {
          "type": "RUN",
          "step": "reader.commit"
        }
      ],
      "sqlStateAssertions": [
        {
          "sqlState": "0A000",
          "minimum": 1,
          "maximum": 1
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "providers": [
        "heap"
      ],
      "sql": "select count(*) from ddl_truncate_t",
      "rows": [
        "0"
      ]
    },
    {
      "providers": [
        "mvcc"
      ],
      "sql": "select count(*) from ddl_truncate_t",
      "rows": [
        "3"
      ]
    }
  ],
  "teardown": [
    "drop table ddl_truncate_t"
  ]
}
