{
  "id": "DEL-DDL-003",
  "description": "TRUNCATE waits for a heap repeatable-read transaction, while MVCC may complete after the reader statement because snapshot readers do not retain the DML schema lock.",
  "category": "ddl-concurrency",
  "providers": [
    "heap",
    "mvcc"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table ddl_truncate_t (id int primary key)${providerClause}",
    "insert into ddl_truncate_t values (1),(2),(3)"
  ],
  "sessions": {
    "reader": {
      "isolation": "REPEATABLE_READ",
      "steps": {
        "read": {
          "sql": "select count(*) from ddl_truncate_t",
          "rows": [
            "3"
          ]
        },
        "stable": {
          "sql": "select count(*) from ddl_truncate_t",
          "rows": [
            "3"
          ]
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    },
    "ddl": {
      "steps": {
        "truncate": {
          "sql": "truncate table ddl_truncate_t"
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    }
  },
  "permutations": [
    {
      "name": "truncate-versus-reader-heap",
      "providers": [
        "heap"
      ],
      "operations": [
        {
          "type": "RUN",
          "step": "reader.read"
        },
        {
          "type": "START",
          "step": "ddl.truncate",
          "token": "truncateTable"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "truncateTable",
          "timeoutMillis": 1200
        },
        {
          "type": "RUN",
          "step": "reader.stable"
        },
        {
          "type": "RUN",
          "step": "reader.commit"
        },
        {
          "type": "AWAIT",
          "token": "truncateTable",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "ddl.commit"
        }
      ]
    },
    {
      "name": "truncate-after-reader-statement-mvcc",
      "providers": [
        "mvcc"
      ],
      "operations": [
        {
          "type": "RUN",
          "step": "reader.read"
        },
        {
          "type": "START",
          "step": "ddl.truncate",
          "token": "truncateTable"
        },
        {
          "type": "AWAIT",
          "token": "truncateTable",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "ddl.commit"
        },
        {
          "type": "RUN",
          "step": "reader.commit"
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "sql": "select count(*) from ddl_truncate_t",
      "rows": [
        "0"
      ]
    }
  ],
  "teardown": [
    "drop table ddl_truncate_t"
  ]
}
