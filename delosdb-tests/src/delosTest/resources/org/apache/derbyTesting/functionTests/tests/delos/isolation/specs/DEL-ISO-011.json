{
  "id": "DEL-ISO-011",
  "description": "An update/delete chain after a savepoint is fully undone by rollback to that savepoint.",
  "category": "savepoint-rollback",
  "providers": [
    "heap",
    "mvcc"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table savepoint_chain_t (id int primary key, payload varchar(32))${providerClause}",
    "insert into savepoint_chain_t values (1, 'one')",
    "insert into savepoint_chain_t values (2, 'two')"
  ],
  "sessions": {
    "transaction": {
      "isolation": "REPEATABLE_READ",
      "steps": {
        "savepoint": {
          "action": "SAVEPOINT",
          "savepoint": "before_chain"
        },
        "update": {
          "sql": "update savepoint_chain_t set payload = 'changed' where id = 1",
          "updateCount": 1
        },
        "delete": {
          "sql": "delete from savepoint_chain_t where id = 2",
          "updateCount": 1
        },
        "changed": {
          "sql": "select id, payload from savepoint_chain_t order by id",
          "rows": [
            "1|changed"
          ]
        },
        "rollback": {
          "action": "ROLLBACK_TO_SAVEPOINT",
          "savepoint": "before_chain"
        },
        "restored": {
          "sql": "select id, payload from savepoint_chain_t order by id",
          "rows": [
            "1|one",
            "2|two"
          ]
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    }
  },
  "permutations": [
    {
      "name": "update-delete-rollback",
      "operations": [
        {
          "type": "RUN",
          "step": "transaction.savepoint"
        },
        {
          "type": "RUN",
          "step": "transaction.update"
        },
        {
          "type": "RUN",
          "step": "transaction.delete"
        },
        {
          "type": "RUN",
          "step": "transaction.changed"
        },
        {
          "type": "RUN",
          "step": "transaction.rollback"
        },
        {
          "type": "RUN",
          "step": "transaction.restored"
        },
        {
          "type": "RUN",
          "step": "transaction.commit"
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "sql": "select id, payload from savepoint_chain_t order by id",
      "rows": [
        "1|one",
        "2|two"
      ]
    }
  ],
  "teardown": [
    "drop table savepoint_chain_t"
  ]
}
