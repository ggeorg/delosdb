{
  "id": "DEL-DDL-004",
  "description": "DROP TRIGGER waits for its active firing transaction and later inserts do not execute the dropped trigger.",
  "category": "ddl-concurrency",
  "providers": [
    "heap",
    "mvcc"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table ddl_trigger_t (id int primary key)${providerClause}",
    "create table ddl_trigger_audit_t (id int primary key)${providerClause}",
    "create trigger ddl_trigger_ai after insert on ddl_trigger_t referencing new as n for each row insert into ddl_trigger_audit_t values (n.id)"
  ],
  "sessions": {
    "writer": {
      "steps": {
        "lockTable": {
          "sql": "lock table ddl_trigger_t in exclusive mode"
        },
        "insert": {
          "sql": "insert into ddl_trigger_t values (1)",
          "updateCount": 1
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    },
    "ddl": {
      "steps": {
        "drop": {
          "sql": "drop trigger ddl_trigger_ai"
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    },
    "after": {
      "steps": {
        "insert": {
          "sql": "insert into ddl_trigger_t values (2)",
          "updateCount": 1
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    }
  },
  "permutations": [
    {
      "name": "trigger-lifecycle",
      "operations": [
        {
          "type": "RUN",
          "step": "writer.lockTable"
        },
        {
          "type": "RUN",
          "step": "writer.insert"
        },
        {
          "type": "START",
          "step": "ddl.drop",
          "token": "dropTrigger"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "dropTrigger",
          "timeoutMillis": 1200
        },
        {
          "type": "RUN",
          "step": "writer.commit"
        },
        {
          "type": "AWAIT",
          "token": "dropTrigger",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "ddl.commit"
        },
        {
          "type": "RUN",
          "step": "after.insert"
        },
        {
          "type": "RUN",
          "step": "after.commit"
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "sql": "select id from ddl_trigger_audit_t order by id",
      "rows": [
        "1"
      ]
    },
    {
      "sql": "select id from ddl_trigger_t order by id",
      "rows": [
        "1",
        "2"
      ]
    }
  ],
  "teardown": [
    "drop table ddl_trigger_t",
    "drop table ddl_trigger_audit_t"
  ]
}
