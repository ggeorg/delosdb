{
  "id": "DEL-DDL-001",
  "description": "DROP TABLE waits for an active reader and removes the table only after reader completion.",
  "category": "ddl-concurrency",
  "providers": [
    "heap",
    "mvcc"
  ],
  "storages": [
    "file",
    "memory"
  ],
  "connections": [
    "embedded"
  ],
  "setup": [
    "create table ddl_drop_t (id int primary key,payload varchar(16))${providerClause}",
    "insert into ddl_drop_t values (1,'one')"
  ],
  "sessions": {
    "reader": {
      "isolation": "REPEATABLE_READ",
      "steps": {
        "read": {
          "sql": "select payload from ddl_drop_t where id=1",
          "rows": [
            "one"
          ]
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    },
    "ddl": {
      "steps": {
        "drop": {
          "sql": "drop table ddl_drop_t"
        },
        "commit": {
          "action": "COMMIT"
        }
      }
    }
  },
  "permutations": [
    {
      "name": "drop-versus-reader",
      "operations": [
        {
          "type": "RUN",
          "step": "reader.read"
        },
        {
          "type": "START",
          "step": "ddl.drop",
          "token": "dropTable"
        },
        {
          "type": "ASSERT_BLOCKED",
          "token": "dropTable",
          "timeoutMillis": 1200
        },
        {
          "type": "RUN",
          "step": "reader.commit"
        },
        {
          "type": "AWAIT",
          "token": "dropTable",
          "timeoutMillis": 10000
        },
        {
          "type": "RUN",
          "step": "ddl.commit"
        }
      ]
    }
  ],
  "finalAssertions": [
    {
      "sql": "select count(*) from sys.systables t,sys.sysschemas s where t.schemaid=s.schemaid and s.schemaname='APP' and t.tablename='DDL_DROP_T'",
      "rows": [
        "0"
      ]
    }
  ],
  "teardown": []
}
